# Application port (host-side)
APP_PORT=8080

# Database path (inside container, matches volume mount)
DB_PATH=/data/licenses.db

# Telegram bot credentials (source of truth — never stored in DB)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Global notification threshold in days (bootstrap default)
NOTIFY_DAYS_BEFORE=60

# Timezone for scheduler and timestamps (IANA name)
TZ=Asia/Almaty

# SQL query logging (true/false)
SQL_ECHO=false

# Deployment host only: pulls in docker-compose.prod.yml, which attaches the
# app to the external nginx-proxy network. Leave this line out locally — the
# overlay needs a proxy-network that exists only on the server.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
